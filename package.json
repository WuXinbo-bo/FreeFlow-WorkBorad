{
  "name": "freeflow-workboard",
  "version": "1.2.0",
  "productName": "FreeFlow",
  "description": "一站式打造属于你的专属办公白板",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "start:web": "node server.js",
    "start:desktop": "set \"ELECTRON_RUN_AS_NODE=\" && electron .",
    "build:canvas-office": "node scripts/build-canvas-office.js",
    "build:canvas-demo": "node scripts/build-canvas-demo.js",
    "build:canvas2d-ui": "node scripts/build-canvas2d-ui.js",
    "build:icons": "node scripts/generate-app-icons.js",
    "prepare:desktop-build": "node scripts/prepare-desktop-build.js",
    "check:desktop-packaging": "node scripts/check-desktop-packaging.js",
    "check:desktop-upgrade": "node scripts/check-desktop-upgrade.js",
    "check:release-version": "node scripts/check-release-version.js",
    "check:generated-bundles": "node scripts/check-generated-bundles.js",
    "test:backend-security": "node scripts/check-backend-security.js",
    "test:desktop-atomic-save": "node scripts/check-desktop-atomic-save.js",
    "test:electron-ipc-security": "node scripts/check-electron-ipc-security.js",
    "test:canvas-lod-scale": "node scripts/check-canvas-lod-scale.js",
    "test:overlay-budget": "node scripts/check-overlay-budget.js",
    "test:interaction-coordination": "node scripts/check-interaction-coordination.js",
    "test:camera-interaction-runtime": "node scripts/check-camera-interaction-runtime.js",
    "test:retained-camera-frame": "node scripts/check-retained-camera-frame.js",
    "test:presentation-quality": "node scripts/check-presentation-quality-runtime.js",
    "test:canvas-performance-policy": "node scripts/check-canvas-performance-policy.js",
    "test:canvas-performance-runtime": "node scripts/check-canvas-performance-runtime.js",
    "test:canvas-render-scheduler": "node scripts/check-canvas-render-scheduler.js",
    "test:canvas-resource-prewarm": "node scripts/check-canvas-resource-prewarm-runtime.js",
    "test:canvas-resource-budget": "node scripts/check-canvas-resource-budget-runtime.js",
    "test:canvas-state-history": "node scripts/check-canvas-state-history.js",
    "test:canvas-operation-results": "node scripts/check-canvas-operation-results.js",
    "test:canvas-semantic-transfer": "node scripts/check-canvas-semantic-transfer.js",
    "test:canvas-presentation-performance": "node scripts/check-canvas-presentation-performance.js",
    "test:canvas-large-scene": "node scripts/check-canvas-large-scene-runtime.js",
    "test:presentation-snapshots": "node scripts/check-presentation-snapshot-controller.js",
    "test:canvas-presentation-snapshots": "node scripts/check-canvas-presentation-snapshots.js",
    "test:compact-presentation": "node scripts/check-compact-presentation-runtime.js",
    "test:canvas-compact-presentation": "node scripts/check-canvas-compact-presentation.js",
    "test:element-runtime": "node scripts/check-element-runtime-architecture.js",
    "test:element-registry": "node scripts/check-builtin-element-registry.js",
    "test:canvas-ui-runtime": "node scripts/check-canvas-ui-runtime.js",
    "test:canvas-command-integration": "node scripts/check-canvas-command-integration.js",
    "test:canvas-desktop-ui": "node scripts/check-canvas-desktop-ui-contract.js",
    "test:canvas-advanced-elements": "node scripts/check-canvas-advanced-element-interactions.js",
    "test:document-preview-runtime": "node scripts/check-document-preview-runtime.js",
    "test:document-preview-browser": "node scripts/check-document-preview-browser.js",
    "test:canvas-element-interactions": "node scripts/check-canvas2d-element-interactions.js",
    "test:structured-parsers": "node scripts/structured-import/run-parser-unit-tests.cjs",
    "test:structured-renderers": "node scripts/structured-import/run-renderer-element-integration.cjs",
    "test:canvas2d": "node scripts/check-canvas2d-regression.js",
    "test:air-canvas-interactions": "node scripts/check-air-canvas-interactions.js",
    "test:panel-resize-performance": "node scripts/check-panel-resize-performance.js",
    "test:startup-lifecycle": "node scripts/check-startup-lifecycle.js",
    "test:settings-center": "node scripts/check-settings-center.js",
    "test:settings-center-browser": "node scripts/check-settings-center-browser.js",
    "test:agent-runtime": "node scripts/check-agent-runtime.js",
    "test:agent-provider-stack": "node scripts/check-agent-provider-stack.js",
    "test:agent-claude-runtime": "node scripts/check-agent-claude-runtime.js",
    "test:agent-http": "node scripts/check-agent-http.js",
    "test:agent-cli-smoke": "node scripts/check-agent-cli-smoke.js",
    "test:agent-browser": "node scripts/check-agent-browser.js",
    "test:window-bounds-lifecycle": "node scripts/check-window-bounds-lifecycle.js",
    "test": "node scripts/run-test-suite.js",
    "check:canvas2d-regression": "node scripts/check-canvas2d-regression.js",
    "check:canvas2d-paste-optimization": "node scripts/check-canvas2d-paste-optimization.js",
    "pack:win": "npm run prepare:desktop-build && npm run check:release-version && npm run check:desktop-packaging && npm run check:desktop-upgrade && electron-builder --dir --win nsis",
    "pack:win:local": "npm run prepare:desktop-build && npm run check:release-version && npm run check:desktop-packaging && npm run check:desktop-upgrade && electron-builder --dir --win nsis",
    "dist:portable": "npm run prepare:desktop-build && npm run check:release-version && npm run check:desktop-packaging && npm run check:desktop-upgrade && electron-builder --win portable",
    "dist:portable:local": "npm run prepare:desktop-build && npm run check:release-version && npm run check:desktop-packaging && npm run check:desktop-upgrade && electron-builder --win portable",
    "dist:win": "npm run prepare:desktop-build && npm run check:release-version && npm run check:desktop-packaging && npm run check:desktop-upgrade && electron-builder --win nsis portable",
    "dist:win:local": "npm run prepare:desktop-build && npm run check:release-version && npm run check:desktop-packaging && npm run check:desktop-upgrade && electron-builder --win nsis portable"
  },
  "keywords": [],
  "author": "Wu Xinbo",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "commonjs",
  "dependencies": {
    "docx": "^9.5.1",
    "express": "^5.2.1",
    "html-to-docx": "^1.8.0",
    "html2canvas": "^1.4.1",
    "katex": "^0.16.45",
    "koffi": "^2.15.2",
    "latex-to-omml": "^2.1.1",
    "mermaid": "^11.14.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "prismjs": "^1.30.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sharp": "^0.34.2",
    "xlsx": "^0.18.5",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.0",
    "playwright": "^1.59.1",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "com.wuxinbo.freeflow",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "src/backend/**/*",
      "scripts/prepare-desktop-build.js",
      "scripts/check-desktop-packaging.js",
      "server.js",
      "package.json",
      ".env.example",
      "!data/**/*",
      "!release/**/*",
      "!public/assets/excalidraw/**/*",
      "!public/src/features/canvas/_archive/**/*",
      "!desktop-agent/**/*",
      "!tmp/**/*",
      "!docs/**/*",
      "!build/icon.png"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/koffi/**/*"
    ],
    "extraResources": [
      {
        "from": "data/FreeFlow教程画布.json",
        "to": "presets/tutorial-board.json"
      },
      {
        "from": "public/assets/tutorial-group.png",
        "to": "presets/tutorial-assets/tutorial-group.png"
      },
      {
        "from": "build/freeflow-selection-word.docx",
        "to": "presets/tutorial-assets/freeflow-selection-word.docx"
      },
      {
        "from": "build/README.md",
        "to": "presets/tutorial-assets/README.md"
      }
    ],
    "npmRebuild": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-v${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "FreeFlow",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-v${version}-${arch}-portable.${ext}"
    }
  }
}
