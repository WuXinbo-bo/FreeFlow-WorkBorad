{
  "heading": "            <div class=\"conversation-heading\">\n              <div class=\"conversation-title-stack\">\n                <div class=\"agent-session-title-row\">\n                  <button id=\"agent-history-toggle-btn\" class=\"agent-icon-button\" type=\"button\" title=\"会话历史\" aria-label=\"会话历史\" aria-expanded=\"false\">\n                    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 6h16M4 12h16M4 18h10\" /></svg>\n                  </button>\n                  <div>\n                    <h2 id=\"conversation-title\">新会话</h2>\n                    <div class=\"agent-session-meta\">\n                      <div id=\"conversation-mode-pill\" class=\"conversation-mode-pill\">Codex · 正在连接</div>\n                      <span id=\"agent-runtime-status\" class=\"agent-runtime-status\" role=\"status\" aria-live=\"polite\"><i aria-hidden=\"true\"></i><span>连接中</span></span>\n                    </div>\n                  </div>\n                </div>\n                <input\n                  id=\"conversation-title-input\"\n                  class=\"panel-input conversation-title-input is-hidden\"\n                  type=\"text\"\n                  maxlength=\"40\"\n                  placeholder=\"输入会话名称\"\n                />\n              </div>\n            </div>\n            <div class=\"conversation-actions\">\n              <button id=\"agent-rename-session-btn\" class=\"agent-icon-button\" type=\"button\" title=\"重命名会话\" aria-label=\"重命名会话\">\n                <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 20h9\" /><path d=\"M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z\" /></svg>\n              </button>\n              <button id=\"agent-fork-session-btn\" class=\"agent-icon-button\" type=\"button\" title=\"创建会话分支\" aria-label=\"创建会话分支\">\n                <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"6\" cy=\"5\" r=\"2\" /><circle cx=\"18\" cy=\"5\" r=\"2\" /><circle cx=\"12\" cy=\"19\" r=\"2\" /><path d=\"M6 7v3c0 2 2 3 6 3s6-1 6-3V7M12 13v4\" /></svg>\n              </button>\n              <details id=\"agent-session-more\" class=\"agent-session-more\">\n                <summary class=\"agent-icon-button\" title=\"会话操作\" aria-label=\"会话操作\">\n                  <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"5\" cy=\"12\" r=\"1.5\" /><circle cx=\"12\" cy=\"12\" r=\"1.5\" /><circle cx=\"19\" cy=\"12\" r=\"1.5\" /></svg>\n                </summary>\n                <div class=\"agent-session-menu ui-chrome-popover\">\n                  <button type=\"button\" data-agent-session-action=\"rename\">重命名</button>\n                  <button type=\"button\" data-agent-session-action=\"fork\">创建分支</button>\n                </div>\n              </details>\n              <button id=\"clear-btn\" class=\"agent-icon-button is-primary\" type=\"button\" title=\"新建会话\" aria-label=\"新建会话\">\n                <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\" /></svg>\n              </button>\n            </div>\n",
  "history": "          <aside id=\"agent-history-panel\" class=\"agent-history-panel is-hidden\" aria-hidden=\"true\">\n            <div class=\"agent-history-head\">\n              <strong>会话</strong>\n              <button id=\"agent-history-close-btn\" class=\"agent-icon-button\" type=\"button\" title=\"关闭会话历史\" aria-label=\"关闭会话历史\">\n                <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m18 6-12 12M6 6l12 12\" /></svg>\n              </button>\n            </div>\n            <label class=\"agent-history-search\">\n              <span class=\"sr-only\">搜索会话</span>\n              <input id=\"agent-history-search-input\" type=\"search\" placeholder=\"搜索会话\" autocomplete=\"off\" />\n            </label>\n            <div id=\"agent-history-list\" class=\"agent-history-list\"></div>\n          </aside>\n\n",
  "composer": "          <div id=\"thread-viewport\" class=\"thread-viewport\">\n            <div id=\"chat-log\" class=\"chat-log\"></div>\n            <button id=\"agent-scroll-bottom\" class=\"agent-scroll-bottom is-hidden\" type=\"button\" title=\"回到底部\" aria-label=\"回到底部\">\n              <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\" /></svg>\n              <span>回到底部</span>\n            </button>\n          </div>\n\n          <section id=\"agent-queue-tray\" class=\"agent-queue-tray is-hidden\" aria-label=\"待发送消息\" aria-live=\"polite\"></section>\n\n          <form id=\"chat-form\" class=\"composer glass-inset ui-chrome-composer\">\n            <div class=\"composer-top\">\n              <div class=\"composer-input-shell\">\n                <div id=\"composer-attachments\" class=\"composer-attachments is-hidden\" aria-label=\"当前附件\"></div>\n                <textarea\n                  id=\"prompt-input\"\n                  rows=\"1\"\n                  maxlength=\"12000\"\n                  placeholder=\"给 FreeFlow 发送消息...\"\n                ></textarea>\n              </div>\n            </div>\n\n              <div class=\"composer-bar\">\n                <div class=\"agent-composer-tools\">\n                  <button id=\"agent-attach-btn\" class=\"agent-icon-button\" type=\"button\" title=\"添加附件\" aria-label=\"添加附件\">\n                    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M21.4 11.6 12 21a6 6 0 0 1-8.5-8.5l10-10a4 4 0 0 1 5.7 5.7L9.5 18a2 2 0 0 1-2.8-2.8L16 6\" /></svg>\n                  </button>\n                  <input id=\"agent-file-input\" type=\"file\" multiple hidden />\n                  <select id=\"agent-submit-mode\" class=\"agent-submit-mode is-hidden\" aria-label=\"运行中消息处理方式\">\n                    <option value=\"queue\">排队发送</option>\n                    <option value=\"steer\">即时引导</option>\n                  </select>\n                  <span id=\"agent-composer-status\" class=\"composer-hint\">Enter 发送 · Shift + Enter 换行</span>\n                </div>\n                <div class=\"composer-actions\">\n                  <button\n                    id=\"composer-thinking-btn\"\n                    class=\"ghost-btn composer-thinking-btn is-hidden\"\n                    type=\"button\"\n                    aria-pressed=\"false\"\n                    aria-label=\"切换 Thinking\"\n                    title=\"切换 Thinking\"\n                  >\n                    <span class=\"composer-thinking-icon\" aria-hidden=\"true\">\n                      <svg viewBox=\"0 0 24 24\">\n                        <path d=\"M9 18h6\" />\n                        <path d=\"M10 21h4\" />\n                        <path d=\"M8.5 14.5c-1.55-1.17-2.5-3.02-2.5-5.1A6 6 0 0 1 12 3.4a6 6 0 0 1 6 6c0 2.08-.95 3.93-2.5 5.1-.56.42-.86 1.02-.86 1.66V17h-5.28v-.84c0-.64-.3-1.24-.86-1.66Z\" />\n                      </svg>\n                    </span>\n                  </button>\n                  <button id=\"stop-btn\" class=\"agent-icon-button is-stop\" type=\"button\" disabled title=\"停止\" aria-label=\"停止\">\n                    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"7\" y=\"7\" width=\"10\" height=\"10\" rx=\"1\" /></svg>\n                  </button>\n                  <button id=\"send-btn\" class=\"agent-icon-button is-primary\" type=\"submit\" title=\"发送\" aria-label=\"发送\">\n                    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m4 4 17 8-17 8 4-8Z\" /><path d=\"M8 12h13\" /></svg>\n                  </button>\n                </div>\n              </div>\n            </form>\n"
