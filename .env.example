# Optional local HTTP port. If occupied, FreeFlow selects an available loopback port.
FREEFLOW_PORT=53127
AI_PROVIDER=bigmodel
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
BIGMODEL_API_KEY=replace-with-your-bigmodel-api-key
BIGMODEL_MODEL=glm-4.7-flash
AI_MODEL=glm-4.7-flash
# GitHub App public Client ID for desktop Device Flow (no client secret in the app)
FREEFLOW_GITHUB_CLIENT_ID=
